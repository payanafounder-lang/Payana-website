# Example settings for the FUTURE backend server. The demo website does not use this file.
# Copy to .env on the server only. Never commit a real .env, and never put secrets in front-end code.

APP_ENV=development
API_BASE_URL=

# Database (PostgreSQL)
DATABASE_URL=

# Auth provider (fill in for the provider you choose)
AUTH_PROVIDER=
AUTH_PROJECT_ID=
AUTH_SECRET=

# Razorpay — server only. Use test keys until launch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# File storage for photos
STORAGE_BUCKET=
